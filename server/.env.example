PORT=4000
# Mongo local (Docker) o Atlas dedicado SOLO a TraGo (readWrite en DB trago).
# No uses el cluster/URI de otro proyecto de clase.
MONGODB_URI=mongodb://127.0.0.1:27018/trago
MONGODB_DB=trago

# Obligatorio · mínimo 32 caracteres aleatorios · SIN valor por defecto en código.
# openssl rand -base64 48
JWT_SECRET=

# Orígenes permitidos (coma). En dev se añade localhost:5173 automáticamente.
CORS_ORIGINS=http://localhost:5173

# Si true, las cadenas nuevas quedan verificadas al registrarse (solo dev/piloto).
# TRAGO_AUTO_VERIFY_CHAIN=true
