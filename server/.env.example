PORT=4000
# Mongo local (Docker) o Atlas dedicado SOLO a TraGo (readWrite en DB trago).
# No uses el cluster/URI de otro proyecto de clase.
MONGODB_URI=mongodb://127.0.0.1:27018/trago
MONGODB_DB=trago

# Obligatorio · mínimo 32 caracteres aleatorios · SIN valor por defecto en código.
# openssl rand -base64 48
JWT_SECRET=

# Orígenes permitidos (coma). En dev se añaden localhost:5173 (vite) y :4173 (preview).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Si true, las cadenas nuevas quedan verificadas al registrarse (solo dev/piloto).
# TRAGO_AUTO_VERIFY_CHAIN=true

# Seed (nunca en production): npm run seed -- --yes
# SEED_DEMO_PASSWORD=cambia-esta-clave-demo

# Overpass / scrapers (contacto real recomendado por política OSM)
TRA_GO_USER_AGENT=TraGo/0.1 (+https://github.com/Darckmoud58/trago-pwa; nearby)

# Cron (Netlify Scheduled / GitHub Actions → Vercel). Obligatorio en prod.
# CRON_SECRET=

# Vercel: la plataforma inyecta VERCEL=1. Opcional en local para probar flags.
# VERCEL=1
# TRUST_PROXY=1
# Front y API en dominios distintos (2 proyectos Vercel):
# AGE_COOKIE_SAMESITE=none

# Web Push — npm run vapid  (npx web-push generate-vapid-keys)
# Misma pública puede ir en trago_web como VITE_VAPID_PUBLIC_KEY; el front
# también la obtiene de GET /api/push/publicKey.
VAPID_SUBJECT=mailto:tu@correo.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Cron: POST /api/cron/refresh-official y POST /api/push/birthday (x-cron-secret)
