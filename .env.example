MONGODB_URI=mongodb://127.0.0.1:27017/trago
MONGODB_DB=trago
AUTH_SECRET=trago-dev-secret-cambia-en-prod-32
# true solo detrás de HTTPS. En Docker local (http://localhost) déjalo en false.
AUTH_COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000
# En Netlify: AUTH_COOKIE_SECURE=true y APP_ORIGIN=https://TU-SITIO.netlify.app
# Login/votos necesitan MONGODB_URI de Atlas. Sin Mongo el catálogo demo igual se ve.
# OAuth de Google Cloud (origen autorizado + redirect http://localhost:3000/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Radio en km para votar (0.4 = ~400 m). En piloto desde casa: 25
NEXT_PUBLIC_TRAGO_PRESENCE_MAX_KM=0.4
# Correos que pueden marcar sucursales participantes
CHAIN_PANEL_EMAILS=
# Si está definido, la API Premium exige header x-api-key
TRAGO_API_KEY=
# Web Push (npx web-push generate-vapid-keys). Misma pública en NEXT_PUBLIC_ y VAPID_
VAPID_SUBJECT=mailto:tu@correo.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Opcional: cron externo POST /api/push/birthday con header x-cron-secret
CRON_SECRET=
# Correo (recuperar contraseña + 2FA). Sin esto, en local se loguea y se muestra preview.
RESEND_API_KEY=
MAIL_FROM=TraGo <onboarding@resend.dev>
# true fuerza preview de enlaces/códigos en JSON de respuesta
TRAGO_MAIL_DEV=true
