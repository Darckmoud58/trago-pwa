        <mxCell id="note2" value="Notación Chen (clásica)&#xa;• Rectángulo = entidad/tabla&#xa;• Óvalo = atributo/campo&#xa;• Rombo = relación&#xa;• Cardinalidad 1 / N en extremos&#xa;• Relación N:N (ámbar) puede llevar atributos&#xa;  (equivale a promoSucursales, reportes…)" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=10;align=left;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="1100" y="80" width="280" height="140" as="geometry"/>
