# Local: vacío = proxy Vite (/api → http://localhost:4000)
# VITE_API_URL=
# O explícito:
# VITE_API_URL=http://localhost:4000

# Vercel (2 proyectos, igual que Todo_pwa): URL del proyecto API, SIN sufijo /api.
# El front ya llama /api/promociones, /api/push/..., etc.
# VITE_API_URL=https://tu-trago-api.vercel.app

# Web Push: la clave pública la entrega GET /api/push/publicKey.
# Opcional si quieres forzarla en build (misma que VAPID_PUBLIC_KEY del server):
# VITE_VAPID_PUBLIC_KEY=
